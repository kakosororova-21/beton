---
import Layout from '../layouts/Layout.astro';
import '../styles/sitemap.css';

const pageTitle = "Карта сайта";
---
<meta name="description" content="Завод товарного бетона в Мурино. Производство и доставка бетона М100–М500, ЦПС, растворов. Собственная лаборатория, контроль качества по ГОСТ. Звоните!">
<meta name="keywords" content="бетон мурино, купить бетон с доставкой, завод бетона ленинградская область, товарный бетон, бетон м300 цена, доставка бетона спб, лаборатория бетона">
<Layout pageTitle={pageTitle}>
    <section id="info">
        <div class="container" id="sitemap">
            <h1>{pageTitle}</h1>
            <ul class="first-item">
                <li><a href="/">Главная</a></li>
                <li><a href="/products">Продукция</a></li>
                <ul class="second-item">
                    <li><a href="/products/concrete">Товарный бетон</a></li>
                    <li><a href="/products/cps">Цементно-песчаные смеси</a></li>
                    <li><a href="/products/rstv">Монтажный раствор</a></li>
                </ul>
                <li><a href="/services">Услуги</a></li>
                <ul class="second-item">
                    <li><a href="/services/composition">Подбор состава бетона</a></li>
                    <li><a href="/services/laboratory">Лабораторные испытания бетона</a></li>
                </ul>
                <li><a href="/delivery">Доставка</a></li>
                <li><a href="/about">О компании</a></li>
            </ul>
        </div>
    </section>
</Layout>
